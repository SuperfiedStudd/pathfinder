{
  "name": "@pathfinder/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build && vite build -c vite.sdk.config.ts && PF_SDK_FORMAT=esm vite build -c vite.sdk.config.ts && cp client/src/sdk/pathfinder.d.ts dist/sdk/pathfinder.d.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/speech": "^8.1.0",
    "@google-cloud/text-to-speech": "^7.1.0",
    "@google/genai": "^2.3.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "tsx": "^4.19.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "module": "./dist/sdk/pathfinder.es.js",
  "exports": {
    ".": {
      "import": "./dist/sdk/pathfinder.es.js"
    }
  },
  "types": "./dist/sdk/pathfinder.d.ts",
  "files": [
    "dist/sdk",
    "README.md",
    "docs/SDK.md"
  ]
}
